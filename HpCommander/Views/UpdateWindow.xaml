<Window x:Class="HpCommander.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating HP Commander"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="StatusText" Text="Downloading..." TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" />

        <TextBlock x:Name="DetailText" Style="{StaticResource NoteTextStyle}" />

        <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Right"
                Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" />
    </StackPanel>
</Window>
