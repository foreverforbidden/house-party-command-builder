<hp:TargetedCommandCategoryViewBase x:Class="HpCommander.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hp="clr-namespace:HpCommander.Views"
             xmlns:controls="clr-namespace:HpCommander.Controls">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Text="Run" Style="{StaticResource SectionHeaderStyle}" />

            <TabControl x:Name="TargetTabs" Style="{StaticResource SegmentedTabControlStyle}"
                        SelectionChanged="TargetTabs_SelectionChanged">

                <TabItem Header="Character" Style="{StaticResource SegmentedTabItemStyle}">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource NoteTextStyle}" MaxWidth="440" HorizontalAlignment="Left"
                                   Text="Runs a function on the characters selected above." />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Item" Style="{StaticResource SegmentedTabItemStyle}">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Item (type an item name directly if it isn't listed)"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <controls:FilteringComboBox x:Name="ItemCombo" IsEditable="True" Width="420"
                                                    HorizontalAlignment="Left"
                                                    SelectionChanged="ItemCombo_SelectionChanged" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="FuncLabel" Text="Function name (unbounded - type any known run function)"
                       Style="{StaticResource FieldLabelStyle}" MaxWidth="440" HorizontalAlignment="Left" TextWrapping="Wrap" />
            <controls:FilteringComboBox x:Name="FuncCombo" IsEditable="True" Width="420" HorizontalAlignment="Left">
                <!-- ContainerStyle rather than the simpler HeaderTemplate, so each heading and its
                     group's own ItemsPresenter sit together in one panel. See also the ComboBox
                     template in Styles/Controls.xaml, which had to stop hardcoding its items host
                     before any of this would render. -->
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource GroupHeaderTextStyle}" />
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </controls:FilteringComboBox>

            <TextBlock Text="Value (optional - some functions take one, e.g. a texture index)"
                       Style="{StaticResource FieldLabelStyle}" MaxWidth="440" HorizontalAlignment="Left"
                       TextWrapping="Wrap" Margin="0,10,0,4" />
            <TextBox x:Name="ValueBox" Width="140" HorizontalAlignment="Left" TextChanged="OnTextChanged" />

            <Button x:Name="ListButton" Content="Build run.list command instead"
                    HorizontalAlignment="Left" Click="ListButton_Click" />
            <TextBlock x:Name="ListNote" Style="{StaticResource NoteTextStyle}" MaxWidth="440" HorizontalAlignment="Left"
                       Visibility="Collapsed"
                       Text="Listing the target's functions. Pick or type a function above to go back to building a run() command." />
        </StackPanel>
    </Border>
</hp:TargetedCommandCategoryViewBase>
