<hp:CommandCategoryViewBase x:Class="HpCommander.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hp="clr-namespace:HpCommander.Views">
    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Info" Style="{StaticResource SectionHeaderStyle}" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10">
                <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="13.5"
                           Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="20" />
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="VersionText" Style="{StaticResource FieldLabelStyle}" />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="IssueButton" Content="Report an issue"
                            Style="{StaticResource PrimaryButtonStyle}" Click="IssueButton_Click" />
                    <Button x:Name="UpdateButton" Content="Check for updates" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="UpdateButton_Click" />
                </StackPanel>

                <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates on startup"
                          Margin="0,10,0,0" Click="AutoUpdateCheck_Click" />

                <TextBlock x:Name="UpdateStatus" Style="{StaticResource NoteTextStyle}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</hp:CommandCategoryViewBase>
