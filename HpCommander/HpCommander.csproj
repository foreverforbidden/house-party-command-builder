<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HpCommander</AssemblyName>
    <RootNamespace>HpCommander</RootNamespace>
    <ApplicationIcon>HP-Commander.ico</ApplicationIcon>

    <!-- Keep in step with the git tag. publish.ps1 overrides this with -Version so a release build
         cannot disagree with the tag it was built from; without it every build claimed 1.0.0 while
         the releases were up to v1.7.0, which the update check would have read as "always stale". -->
    <Version>1.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\info.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <!-- ApplicationIcon sets the exe icon; WPF needs it as a Resource for the window's
         title-bar/taskbar icon at runtime. -->
    <Resource Include="HP-Commander.ico" />
  </ItemGroup>

</Project>
